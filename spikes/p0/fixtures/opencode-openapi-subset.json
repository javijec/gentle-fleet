      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SessionNotFoundErrorEncoded"
        }
       }
      }
     }
    },
    "description": "Create a session at the requested location. A parentID creates a linked child session at its parent's location.",
    "summary": "Create session",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "id": {
          "anyOf": [
           {
            "$ref": "#/components/schemas/Session.ID"
           },
           {
            "type": "null"
           }
          ]
         },
         "parentID": {
          "anyOf": [
           {
            "$ref": "#/components/schemas/Session.ID"
           },
           {
            "type": "null"
           }
          ],
          "description": "Set parentID to create a subagent session at the parent's location; set agent to choose its agent (otherwise it uses the default) and start it with session.prompt. After each completed round, the child sends a `<subagent>` report to the parent's inbox and wakes the parent unless it has a staged revert."
         },
         "title": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "agent": {
          "anyOf": [
           {
            "$ref": "#/components/schemas/Agent.ID"
           },
           {
            "type": "null"
           }
          ]
         },
         "model": {
          "anyOf": [
