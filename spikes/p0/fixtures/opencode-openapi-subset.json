          "data": {
           "$ref": "#/components/schemas/V2EventEncoded"
          }
         },
         "required": [
          "event",
          "data"
         ],
         "additionalProperties": false
        },
        "x-effect-stream": {
         "encoding": "sse",
         "causeSchema": {
          "type": "array",
          "items": {
           "anyOf": [
            {
             "type": "object",
             "properties": {
              "_tag": {
               "type": "string",
               "enum": [
                "Fail"
               ]
              },
              "error": {
               "not": {}
              }
             },
             "required": [
              "_tag",
              "error"
             ],
             "additionalProperties": false
            },
            {
             "type": "object",
             "properties": {
              "_tag": {
               "type": "string",
               "enum": [
                "Die"
               ]
              },
              "defect": {}
             },
             "required": [
              "_tag",
              "defect"
             ],
             "additionalProperties": false
            },
            {
             "type": "object",
             "properties": {
              "_tag": {
               "type": "string",
               "enum": [
                "Interrupt"
               ]
              },
              "fiberId": {
               "anyOf": [
                {
                 "type": "number"
                },
                {
                 "type": "null"
                }
               ]
              }
             },
             "required": [
              "_tag",
              "fiberId"
             ],
             "additionalProperties": false
            }
           ]
          }
         },
         "errorSchema": {
          "not": {}
         },
         "failureEvent": "effect/http-api/stream/failure"
        }
       }
      }
     },
     "400": {
      "description": "InvalidRequestError",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/InvalidRequestErrorEncoded"
